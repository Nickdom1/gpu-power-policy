diff --git a/src/nvidia/arch/nvalloc/unix/src/registry.c b/src/nvidia/arch/nvalloc/unix/src/registry.c
index 70bbcc5..742604e 100644
--- a/src/nvidia/arch/nvalloc/unix/src/registry.c
+++ b/src/nvidia/arch/nvalloc/unix/src/registry.c
@@ -24,6 +24,7 @@
 #include <nv.h>
 #include <nv-priv.h>
 #include <nvos.h>
+#include "os-interface.h"
 
 #if defined(DEBUG_REGISTRY)
 #define DBG_REG_PRINTF(a, ...) \
@@ -379,6 +380,39 @@ NV_STATUS RmWriteRegistryBinary(
     return NV_OK;
 }
 
+/* Local boot experiment. Called with RM/GPU init serialization held. */
+NV_STATUS NV_API_CALL os_install_boot_policy(void *gpu, NvU8 *image, NvU32 size)
+{
+    nv_state_t *nv = gpu;
+    nv_priv_t *nvp;
+    nv_reg_entry_t *entry;
+    NvU32 list, key;
+    NV_STATUS status;
+    static const char * const keys[] = {
+        "vbios", "vbios000", "vbios001", "vbios002", "vbios003",
+        "vbios004", "vbios005", "vbios006", "vbios007", "vbios008"
+    };
+
+    if (nv == NULL || image == NULL || size != 516608U)
+        return NV_ERR_INVALID_ARGUMENT;
+    nvp = NV_GET_NV_PRIV(nv);
+    if (nvp == NULL)
+        return NV_ERR_INVALID_STATE;
+    for (list = 0; list < 2; list++)
+        for (entry = list == 0 ? nvp->pRegistry : the_registry;
+             entry != NULL; entry = entry->next)
+            for (key = 0; key < sizeof(keys) / sizeof(keys[0]); key++)
+                if (entry->regParmStr != NULL &&
+                    stringCaseCompare(entry->regParmStr, keys[key]) == 0)
+                    return NV_ERR_INVALID_STATE;
+
+    /* RmWriteRegistryBinary owns a fresh copy; the caller frees its temporary. */
+    status = RmWriteRegistryBinary(nv, "vbios", image, size);
+    if (status == NV_OK)
