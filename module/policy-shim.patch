diff --git a/kernel-open/nvidia/nv-boot-policy.c b/kernel-open/nvidia/nv-boot-policy.c
new file mode 100644
index 0000000..c280cc2
--- /dev/null
+++ b/kernel-open/nvidia/nv-boot-policy.c
@@ -0,0 +1,145 @@
+// SPDX-License-Identifier: MIT
+/* Local, exact-image boot experiment. Never reads or writes a ROM device. */
+#include "os-interface.h"
+#include "nv-linux.h"
+#include <crypto/sha2.h>
+
+#define POLICY_RAW_SIZE 600576U
+#define POLICY_SIZE 516608U
+#define POLICY_MAX_OFFSET 0x735e8U
+
+/* Load-time only: 1 transports unchanged policy; 2 raises its maximum to 120 W;
+ * 3 raises its maximum to 125 W. No mode issues a runtime Set request.
+ * The ordinary boot remains mode 0.
+ */
+static unsigned int nv_boot_policy_mode;
+module_param_named(NVreg_Pt516BootPolicy, nv_boot_policy_mode, uint, 0400);
+MODULE_PARM_DESC(NVreg_Pt516BootPolicy,
+    "PT516 exact-image experiment: 0 off, 1 compact control, 2 compact 120W maximum, 3 compact 125W maximum");
+
+static const unsigned char policy_raw_sha256[32] = {
+    0x13,0x05,0x19,0x02,0xcd,0x7d,0xe8,0x84,0x71,0x89,0xdf,0x50,0xa4,0xe9,0xa2,0xd8,
+    0x4d,0x5f,0xde,0xd6,0x21,0x54,0x67,0x89,0x5c,0xa5,0x50,0x19,0x84,0x91,0xad,0xb1
+};
+static const unsigned char policy_compact_sha256[32] = {
+    0xe8,0xd7,0x99,0xce,0xab,0xb1,0x4c,0x64,0xd8,0xb9,0xd1,0xd9,0x62,0x3c,0xea,0x3e,
+    0x46,0xa6,0x9f,0xed,0x7f,0x43,0xfc,0x95,0xc1,0xdc,0xd0,0x2f,0x2c,0x16,0x47,0x52
+};
+
+/* Queue allocation precedes extraction. Only the explicit mode and PCI target
+ * are available here; the existing full-image hash gate still runs before use.
+ */
+NvBool NV_API_CALL os_boot_policy_queue_enabled(void *gpu)
+{
+    nv_state_t *nv = gpu;
+    return nv != NULL && nv_boot_policy_mode >= 1 && nv_boot_policy_mode <= 3 &&
+        nv->pci_info.domain == 0 && nv->pci_info.bus == 1 &&
+        nv->pci_info.slot == 0 && nv->pci_info.function == 0 &&
+        nv->pci_info.vendor_id == 0x10de && nv->pci_info.device_id == 0x2460;
+}
+
+static unsigned char policy_sum8(const unsigned char *p, NvU32 size)
+{
+    unsigned char sum = 0;
+    while (size--)
+        sum += *p++;
+    return sum;
+}
+
+NV_STATUS NV_API_CALL os_prepare_boot_policy(void *gpu, NvU32 extraction_status,
+    const void *image, NvU32 size, NvU32 expansion_offset, void **out, NvU32 *out_size)
+{
+    nv_state_t *nv = gpu;
+    const unsigned char *raw = image;
+    unsigned char *copy, digest[32];
+    NV_STATUS status;
+
+    if (out == NULL || out_size == NULL)
+        return NV_ERR_INVALID_ARGUMENT;
+    *out = NULL;
+    *out_size = 0;
+    if (nv_boot_policy_mode == 0)
+        return NV_OK;
+    if (nv_boot_policy_mode > 3 || nv == NULL ||
+        nv->pci_info.domain != 0 || nv->pci_info.bus != 1 ||
+        nv->pci_info.slot != 0 || nv->pci_info.function != 0 ||
+        nv->pci_info.vendor_id != 0x10de || nv->pci_info.device_id != 0x2460 ||
+        extraction_status != NV_OK || image == NULL || size != POLICY_RAW_SIZE ||
+        expansion_offset != 83968)
+        return NV_ERR_INVALID_ARGUMENT;
+
+    sha256(raw, size, digest);
+    if (memcmp(digest, policy_raw_sha256, sizeof(digest)) != 0)
+        return NV_ERR_INVALID_DATA;
+    status = os_alloc_mem((void **)&copy, POLICY_SIZE);
+    if (status != NV_OK)
+        return status;
+    /* Remove only the verified UEFI subimage. Keep the host FWSEC input intact. */
+    memcpy(copy, raw, 0xfe00);
+    memcpy(copy + 0xfe00, raw + 0x24600, POLICY_RAW_SIZE - 0x24600);
+    sha256(copy, POLICY_SIZE, digest);
+    if (memcmp(digest, policy_compact_sha256, sizeof(digest)) != 0 ||
+        memcmp(copy + POLICY_MAX_OFFSET, "\x38\xc1\x01\x00", 4) != 0 ||
+        copy[POLICY_SIZE - 1] != 0x63)
+    {
+        os_free_mem(copy);
+        return NV_ERR_INVALID_DATA;
+    }
+    if (nv_boot_policy_mode == 2)
+    {
+        /* 115000 -> 120000 mW; rated 80000, role map and all other entries stay. */
+        copy[POLICY_MAX_OFFSET] = 0xc0;
+        copy[POLICY_MAX_OFFSET + 1] = 0xd4;
+        /* Exact-image checksum byte; acceptance by later consumers is a trial. */
+        copy[POLICY_SIZE - 1] = 0xc8;
+    }
+    else if (nv_boot_policy_mode == 3)
+    {
+        /* 115000 -> 125000 mW; only the same policy maximum and checksum. */
+        copy[POLICY_MAX_OFFSET] = 0x48;
+        copy[POLICY_MAX_OFFSET + 1] = 0xe8;
+        copy[POLICY_SIZE - 1] = 0x2c;
+    }
+    if (policy_sum8(copy, 0xfe00) || policy_sum8(copy + 0xfe00, 0x5600) ||
+        policy_sum8(copy + 0x15400, POLICY_SIZE - 0x15400))
+    {
+        os_free_mem(copy);
+        return NV_ERR_INVALID_DATA;
+    }
+    sha256(copy, POLICY_SIZE, digest);
+    nv_printf(NV_DBG_ERRORS,
+        "NVRM: PT516 boot policy PREPARED mode=%u bytes=%u sha256=%*phN; GSP use unverified\n",
+        nv_boot_policy_mode, POLICY_SIZE, 32, digest);
+    *out = copy;
+    *out_size = POLICY_SIZE;
+    return NV_OK;
+}
+
+void NV_API_CALL os_boot_policy_registered(void *gpu)
+{
+    nv_state_t *nv = gpu;
+    WRITE_ONCE(NV_GET_NVL_FROM_NV_STATE(nv)->boot_policy_registered, NV_TRUE);
+}
+
+/* Bound the registered image plus <=64 KiB of ordinary registry data.
+ * This does not authorize a message larger than the boot command queue.
+ */
+NvBool NV_API_CALL os_boot_policy_large_registry(void *gpu, NvU32 table_size)
+{
+    nv_state_t *nv = gpu;
+    return nv != NULL && nv_boot_policy_mode >= 1 && nv_boot_policy_mode <= 3 &&
+        READ_ONCE(NV_GET_NVL_FROM_NV_STATE(nv)->boot_policy_registered) &&
+        table_size >= POLICY_SIZE && table_size <= POLICY_SIZE + 65536U;
+}
+
+/* A failed insertion must not become a stock-image boot on an init retry that
+ * reuses FWSEC and skips the extraction block. */
+NvBool NV_API_CALL os_boot_policy_ready(void *gpu)
+{
+    return nv_boot_policy_mode == 0 || os_boot_policy_large_registry(gpu, POLICY_SIZE);
+}
+
+NvBool NV_API_CALL os_boot_policy_registry_fits(void *gpu, NvU32 table_size)
+{
+    return nv_boot_policy_mode == 0 || os_boot_policy_large_registry(gpu, table_size);
+}
diff --git a/kernel-open/nvidia/nv-boot-vbios.c b/kernel-open/nvidia/nv-boot-vbios.c
new file mode 100644
index 0000000..e184658
--- /dev/null
+++ b/kernel-open/nvidia/nv-boot-vbios.c
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: MIT
+/* Local diagnostic: retain an existing boot ROM read, with no extra GPU access. */
+#include "os-interface.h"
+#include "nv-linux.h"
+#include "nv-procfs.h"
+
+#define NV_BOOT_VBIOS_MAX_SIZE (1024U * 1024U)
+#define NV_BOOT_VBIOS_HEADER_SIZE 64U
+#define NV_BOOT_VBIOS_NOT_REACHED 0U
+#define NV_BOOT_VBIOS_CAPTURED 1U
+#define NV_BOOT_VBIOS_EXTRACT_FAILED 2U
+#define NV_BOOT_VBIOS_INVALID_IMAGE 3U
+#define NV_BOOT_VBIOS_NO_MEMORY 4U
+
+static bool nv_boot_vbios_enabled;
+module_param_named(NVreg_CaptureBootVbios, nv_boot_vbios_enabled, bool, 0400);
+MODULE_PARM_DESC(NVreg_CaptureBootVbios,
+    "Retain first existing boot ROM extraction for root-only diagnostic read (default off)");
+
+static DEFINE_MUTEX(nv_boot_vbios_lock);
+
+void NV_API_CALL os_capture_boot_vbios(void *gpu, NvU32 rm_status,
+    const void *image, NvU32 size, NvU32 expansion_offset)
+{
+    nv_state_t *nv = gpu;
+    nv_linux_state_t *nvl;
+
+    if (!nv_boot_vbios_enabled || gpu == NULL || !IS_ENABLED(CONFIG_PROC_FS))
+        return;
+
+    nvl = NV_GET_NVL_FROM_NV_STATE(nv);
+    mutex_lock(&nv_boot_vbios_lock);
+    /* Freeze even failed attempts: a later retry must not hide the first result. */
+    if (nvl->boot_vbios_state != NV_BOOT_VBIOS_NOT_REACHED)
+        goto out;
+
+    nvl->boot_vbios_rm_status = rm_status;
+    if (rm_status != NV_OK)
+    {
+        nvl->boot_vbios_state = NV_BOOT_VBIOS_EXTRACT_FAILED;
+        goto out;
+    }
+    if (image == NULL || size == 0 || size > NV_BOOT_VBIOS_MAX_SIZE ||
+        expansion_offset > size)
+    {
+        nvl->boot_vbios_state = NV_BOOT_VBIOS_INVALID_IMAGE;
+        goto out;
+    }
+
+    nvl->boot_vbios_data = kvmalloc(size, GFP_KERNEL);
+    if (nvl->boot_vbios_data == NULL)
+    {
+        nvl->boot_vbios_state = NV_BOOT_VBIOS_NO_MEMORY;
+        goto out;
+    }
+    memcpy(nvl->boot_vbios_data, image, size);
+    nvl->boot_vbios_size = size;
+    nvl->boot_vbios_expansion_offset = expansion_offset;
+    nvl->boot_vbios_state = NV_BOOT_VBIOS_CAPTURED;
+out:
+    mutex_unlock(&nv_boot_vbios_lock);
+}
+
+/* Called at final Linux-state lock destruction, including failed PCI probe. */
+void nv_boot_vbios_free(nv_linux_state_t *nvl)
+{
+    mutex_lock(&nv_boot_vbios_lock);
+    kvfree(nvl->boot_vbios_data);
+    nvl->boot_vbios_data = NULL;
+    nvl->boot_vbios_size = 0;
+    nvl->boot_vbios_expansion_offset = 0;
+    nvl->boot_vbios_rm_status = 0;
+    nvl->boot_vbios_state = NV_BOOT_VBIOS_NOT_REACHED;
+    mutex_unlock(&nv_boot_vbios_lock);
+}
+
+#if defined(CONFIG_PROC_FS)
+struct nv_boot_vbios_snapshot
+{
+    size_t size;
+    unsigned char bytes[];
+};
+
+static void nv_boot_vbios_put32(unsigned char *p, NvU32 value)
+{
+    p[0] = value;
+    p[1] = value >> 8;
+    p[2] = value >> 16;
+    p[3] = value >> 24;
+}
+
+static int nv_boot_vbios_open(struct inode *inode, struct file *file)
+{
+    nv_linux_state_t *nvl = NV_PDE_DATA(inode);
+    nv_state_t *nv = NV_STATE_PTR(nvl);
+    struct nv_boot_vbios_snapshot *snapshot;
+    unsigned char *header;
+    size_t size;
+
+    if (!capable(CAP_SYS_ADMIN) || (file->f_mode & FMODE_WRITE))
+        return -EPERM;
+
+    /* No nv_open_device, RM call, PM lock, runtime resume or hardware read here.
+     * proc_remove drains this callback before nvl can be freed. Each successful
+     * open owns its snapshot; later reads/release never dereference nvl.
+     */
+    mutex_lock(&nv_boot_vbios_lock);
+    size = NV_BOOT_VBIOS_HEADER_SIZE + nvl->boot_vbios_size;
+    snapshot = kvzalloc(sizeof(*snapshot) + size, GFP_KERNEL);
+    if (snapshot == NULL)
+    {
+        mutex_unlock(&nv_boot_vbios_lock);
+        return -ENOMEM;
+    }
+    snapshot->size = size;
+    header = snapshot->bytes;
+    memcpy(header, "NVBROM1", 8);
+    nv_boot_vbios_put32(header + 8, 1); /* format version */
+    nv_boot_vbios_put32(header + 12, NV_BOOT_VBIOS_HEADER_SIZE);
+    nv_boot_vbios_put32(header + 16, nvl->boot_vbios_state);
+    nv_boot_vbios_put32(header + 20, nvl->boot_vbios_rm_status);
+    nv_boot_vbios_put32(header + 24, nvl->boot_vbios_size);
+    nv_boot_vbios_put32(header + 28, nvl->boot_vbios_expansion_offset);
+    nv_boot_vbios_put32(header + 32, nv->pci_info.domain);
+    nv_boot_vbios_put32(header + 36, nv->pci_info.bus);
+    nv_boot_vbios_put32(header + 40, nv->pci_info.slot);
+    nv_boot_vbios_put32(header + 44, nv->pci_info.function);
+    nv_boot_vbios_put32(header + 48, nv->pci_info.vendor_id);
+    nv_boot_vbios_put32(header + 52, nv->pci_info.device_id);
+    /* Bytes56..63 reserved, zero. Failure/not-reached snapshots have no payload. */
+    if (nvl->boot_vbios_size != 0)
+        memcpy(header + NV_BOOT_VBIOS_HEADER_SIZE,
+               nvl->boot_vbios_data, nvl->boot_vbios_size);
+    mutex_unlock(&nv_boot_vbios_lock);
+    file->private_data = snapshot;
+    return 0;
+}
+
+static ssize_t nv_boot_vbios_read(struct file *file, char __user *buffer,
+    size_t count, loff_t *position)
+{
+    struct nv_boot_vbios_snapshot *snapshot = file->private_data;
+
+    return simple_read_from_buffer(buffer, count, position,
+                                   snapshot->bytes, snapshot->size);
+}
+
+static int nv_boot_vbios_release(struct inode *inode, struct file *file)
+{
+    kvfree(file->private_data);
+    file->private_data = NULL;
+    return 0;
+}
+
+static const nv_proc_ops_t nv_boot_vbios_ops = {
+    NV_PROC_OPS_SET_OWNER()
+    .NV_PROC_OPS_OPEN = nv_boot_vbios_open,
+    .NV_PROC_OPS_READ = nv_boot_vbios_read,
+    .NV_PROC_OPS_LSEEK = default_llseek,
+    .NV_PROC_OPS_RELEASE = nv_boot_vbios_release,
+};
+#endif
+
+void nv_boot_vbios_add_proc(nv_linux_state_t *nvl, struct proc_dir_entry *parent)
+{
+#if defined(CONFIG_PROC_FS)
+    if (nv_boot_vbios_enabled &&
+        proc_create_data("boot_vbios", S_IFREG | 0400, parent,
+                         &nv_boot_vbios_ops, nvl) == NULL)
+        nv_printf(NV_DBG_ERRORS, "NVRM: boot VBIOS diagnostic export unavailable\n");
+#endif
+}
